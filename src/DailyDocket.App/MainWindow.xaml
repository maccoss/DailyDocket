<Window x:Class="DailyDocket.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DailyDocket.App.ViewModels"
        xmlns:views="clr-namespace:DailyDocket.App.Views"
        Title="DailyDocket" Icon="pack://application:,,,/DailyDocket;component/Assets/app.ico" Width="1100" Height="820" MinWidth="560" MinHeight="420"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header: the date, Refresh. -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16,24,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="DailyDocket" FontFamily="Georgia" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Today}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,4" VerticalAlignment="Bottom" />
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" ToolTip="Sync calendar, mail and Slack now" />
                <!-- An update is downloaded: upper right, where it is seen (LabOps' place for it); it
                     installs only when pressed. Its DataContext is the UpdateBarViewModel (set in code). -->
                <StackPanel x:Name="UpdateBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,0"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Visibility>
                            <Binding Path="Note" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <Button Content="{Binding Label}" Command="{Binding RestartCommand}" Style="{StaticResource PrimaryButton}"
                            ToolTip="Close DailyDocket, install the update and open it again" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Syncing..." Style="{StaticResource Muted}" Margin="0,0,12,6" VerticalAlignment="Bottom"
                           Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- Status: online, when each source last synced, the outbox, the local model. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Something to act on: setup, sign-in, a failed sync. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8"
                Margin="24,12,24,0" Padding="12,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Banner}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Banner}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
        </Border>

        <TabControl Margin="24,12,24,0" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="SCHEDULE">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ScheduleSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ScheduleOutbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OutboxView}">
                                    <Border CornerRadius="8" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="Discard" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.DiscardOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanEditNow, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Send again" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.SendAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Undo" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.UndoSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Problem" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DayItem}">
                                    <StackPanel Margin="0,0,0,18">
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Heading}" FontFamily="Georgia" FontSize="18.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Date}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Background}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:BannerItem}">
                                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Tag}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EventItem}">
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsReply}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Clash}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CritBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Quiet}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="Padding" Value="12,5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" Margin="0,1,0,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                                                <WrapPanel Margin="0,3,0,0">
                                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}">
                                                                        <Border.Visibility>
                                                                            <Binding Path="Tag" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                                        </Border.Visibility>
                                                                        <TextBlock Text="{Binding Tag}" Style="{StaticResource ChipText}" Foreground="{StaticResource AccentBrush}" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource CritSoftBrush}" Visibility="{Binding Clash, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="clash" Style="{StaticResource ChipText}" Foreground="{StaticResource CritBrush}" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoftBrush}" Visibility="{Binding NeedsReply, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="not answered" Style="{StaticResource ChipText}" Foreground="{StaticResource WarnBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Location}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                                <Button Content="Join" HorizontalAlignment="Right" Margin="0,0,0,4" Style="{StaticResource OpenButton}"
                                                                        ToolTip="{Binding JoinLink}"
                                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JoinLink}">
                                                                    <Button.Visibility>
                                                                        <Binding Path="JoinLink" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                                    </Button.Visibility>
                                                                </Button>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding CanRespond, Converter={StaticResource BoolToVisibility}}">
                                                                    <Button Content="Accept" Style="{StaticResource OpenButton}" Margin="0,0,4,0" ToolTip="Accept (you can undo for a minute)"
                                                                            Command="{Binding DataContext.AcceptEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                    <Button Content="Maybe" Style="{StaticResource OpenButton}" Margin="0,0,4,0" ToolTip="Tentative"
                                                                            Command="{Binding DataContext.TentativeEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                    <Button Content="Decline" Style="{StaticResource OpenButton}" ToolTip="Decline"
                                                                            Command="{Binding DataContext.DeclineEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Response, StringFormat=You: {0}}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                                    <TextBlock.Visibility>
                                                                        <Binding Path="Response" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                                <Button Content="Prep now" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                        ToolTip="Claude writes (or rewrites) a brief for this meeting from the invitation, your email and linked documents"
                                                                        Command="{Binding DataContext.PrepNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource OpenButton}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPrepping}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding PrepNote}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="110,6,0,0">
                                                            <TextBlock.Visibility>
                                                                <Binding Path="PrepNote" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <!-- The meeting brief, folded until wanted; read from the data repository, so offline too. -->
                                                        <!-- IsExpanded is bound through the event's card (its DataContext is the brief): a reload keeps it open. -->
                                                        <Expander Header="Brief" Margin="110,6,0,0" DataContext="{Binding Brief}" Foreground="{StaticResource Ink2Brush}"
                                                                  IsExpanded="{Binding DataContext.BriefOpen, RelativeSource={RelativeSource AncestorType=StackPanel}, Mode=TwoWay}">
                                                            <Expander.Visibility>
                                                                <Binding Converter="{x:Static vm:Converters.NotNullToVisibility}" />
                                                            </Expander.Visibility>
                                                            <StackPanel Margin="4,6,0,4">
                                                                <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stale}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl Tag="Who" ItemsSource="{Binding Who}" Style="{StaticResource BriefSection}" />
                                                                <ItemsControl Tag="Agenda" ItemsSource="{Binding Agenda}" Style="{StaticResource BriefSection}" />
                                                                <ItemsControl Tag="Context" ItemsSource="{Binding Context}" Style="{StaticResource BriefSection}" />
                                                                <ItemsControl Tag="You owe" ItemsSource="{Binding Owes}" Style="{StaticResource BriefSection}" />
                                                                <ItemsControl Tag="Gaps and questions" ItemsSource="{Binding Gaps}" Style="{StaticResource BriefSection}" />
                                                            </StackPanel>
                                                        </Expander>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="TO DO">
                <views:TodoTab DataContext="{Binding Todos}" />
            </TabItem>

            <TabItem Header="EMAIL">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MailSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                            <DockPanel.Visibility>
                                <Binding Path="UndoText" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                            </DockPanel.Visibility>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding UndoText}" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Left" Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource OpenButton}" Margin="8,0,0,0" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Mail}" SelectedItem="{Binding SelectedMail}" Style="{StaticResource RowList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MailItem}">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Staleness}" Value="1">
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Staleness}" Value="2">
                                                        <Setter Property="BorderBrush" Value="{StaticResource CritBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding From}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subject}" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBrush}" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="unsent draft" Style="{StaticResource ChipText}" Foreground="White" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Background="{StaticResource OkBrush}" Padding="8,3">
                                                    <Border.Visibility>
                                                        <Binding Path="Why" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                    </Border.Visibility>
                                                    <TextBlock Text="{Binding Why}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Margin="6,0" />
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MailReaderTitle}" FontFamily="Georgia" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel.Visibility>
                                <Binding Path="MailReaderTitle" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                            </StackPanel.Visibility>
                            <Button Content="Reply" Command="{Binding ReplyMailCommand}" Margin="0,0,6,0" />
                            <Button Content="Reply all" Command="{Binding ReplyAllMailCommand}" Margin="0,0,18,0" />
                            <Button Content="To do" Command="{Binding CaptureMailCommand}" ToolTip="Make this a task and mark it handled" Margin="0,0,6,0" />
                            <Button Content="Handled" Command="{Binding HandleMailCommand}" ToolTip="Hide this until someone writes again" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBox Text="{Binding CaptureTitle, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" ToolTip="Task" />
                                <TextBlock Text="{Binding CaptureNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                    <TextBlock.Visibility>
                                        <Binding Path="CaptureNote" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBox Text="{Binding CaptureNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,6,0,0" ToolTip="Notes" />
                                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Tags" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox DockPanel.Dock="Left" Text="{Binding CaptureTags, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="Comma separated" />
                                    <TextBlock DockPanel.Dock="Left" Text="Due" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding CaptureDue}" Width="130" />
                                    <Button DockPanel.Dock="Right" Content="Add and mark handled" Command="{Binding SaveCaptureCommand}" Margin="6,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="Draft with Claude" Command="{Binding SuggestTaskCommand}" Margin="6,0,0,0" ToolTip="Claude suggests the task's title, notes, date and tag from the message" />
                                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCaptureCommand}" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding MailOutbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OutboxView}">
                                    <Border CornerRadius="8" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="Discard" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.DiscardOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanEditNow, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Send again" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.SendAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Undo" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.UndoSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Problem" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <views:ComposeBox DockPanel.Dock="Top" DataContext="{Binding MailCompose}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,20,0,0"
                                   Text="Select a thread to read it here. It is stored on this computer, so it reads offline.">
                            <TextBlock.Visibility>
                                <Binding Path="MailReaderTitle" Converter="{x:Static vm:Converters.EmptyToVisibility}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MailReader}" ItemTemplate="{StaticResource MessageTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SLACK">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SlackSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                            <DockPanel.Visibility>
                                <Binding Path="UndoText" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                            </DockPanel.Visibility>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding UndoText}" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Left" Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource OpenButton}" Margin="8,0,0,0" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Slack}" SelectedItem="{Binding SelectedSlack}" Style="{StaticResource RowList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SlackItem}">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stale}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding From}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Where}" Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="13" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource OkBrush}" Padding="8,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <Border.Visibility>
                                                    <Binding Path="Why" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                </Border.Visibility>
                                                <TextBlock Text="{Binding Why}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Margin="6,0" />
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SlackReaderTitle}" FontFamily="Georgia" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel.Visibility>
                                <Binding Path="SlackReaderTitle" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                            </StackPanel.Visibility>
                            <Button Content="Reply" Command="{Binding ReplySlackCommand}" Margin="0,0,18,0" />
                            <Button Content="To do" Command="{Binding CaptureSlackCommand}" ToolTip="Make this a task and mark it handled" Margin="0,0,6,0" />
                            <Button Content="Handled" Command="{Binding HandleSlackCommand}" ToolTip="Hide this until someone writes again" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBox Text="{Binding CaptureTitle, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" ToolTip="Task" />
                                <TextBlock Text="{Binding CaptureNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                    <TextBlock.Visibility>
                                        <Binding Path="CaptureNote" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBox Text="{Binding CaptureNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,6,0,0" ToolTip="Notes" />
                                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Tags" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox DockPanel.Dock="Left" Text="{Binding CaptureTags, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="Comma separated" />
                                    <TextBlock DockPanel.Dock="Left" Text="Due" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding CaptureDue}" Width="130" />
                                    <Button DockPanel.Dock="Right" Content="Add and mark handled" Command="{Binding SaveCaptureCommand}" Margin="6,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="Draft with Claude" Command="{Binding SuggestTaskCommand}" Margin="6,0,0,0" ToolTip="Claude suggests the task's title, notes, date and tag from the message" />
                                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCaptureCommand}" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SlackOutbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OutboxView}">
                                    <Border CornerRadius="8" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="Discard" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.DiscardOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanEditNow, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditOutboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Send again" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.SendAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Undo" Style="{StaticResource OpenButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.UndoSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Problem" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <views:ComposeBox DockPanel.Dock="Top" DataContext="{Binding SlackCompose}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,20,0,0"
                                   Text="Select a conversation to read it here. It is stored on this computer, so it reads offline.">
                            <TextBlock.Visibility>
                                <Binding Path="SlackReaderTitle" Converter="{x:Static vm:Converters.EmptyToVisibility}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SlackReader}" ItemTemplate="{StaticResource MessageTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
