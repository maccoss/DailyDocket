<Application x:Class="DailyDocket.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- The dashboard artifact's palette. -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F7F9F9" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#F0F4F4" />
        <SolidColorBrush x:Key="InkBrush" Color="#101A21" />
        <SolidColorBrush x:Key="Ink2Brush" Color="#36474F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#61727C" />
        <SolidColorBrush x:Key="LineBrush" Color="#D5DDE1" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#E6ECEE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0E6A6B" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#D8EDEC" />
        <SolidColorBrush x:Key="CritBrush" Color="#A32E2E" />
        <SolidColorBrush x:Key="CritSoftBrush" Color="#F6E0DE" />
        <SolidColorBrush x:Key="WarnBrush" Color="#8A5A06" />
        <SolidColorBrush x:Key="WarnSoftBrush" Color="#F6EBD6" />
        <SolidColorBrush x:Key="OkBrush" Color="#2C6E4C" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small link-like button: Open in Gmail, Open in Slack. -->
        <Style x:Key="OpenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,2" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>

        <!-- A list of cards: no system selection highlight (the card shows it), text wraps. -->
        <Style x:Key="RowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          One message in the reader. The text is a read-only TextBox so it can be selected and copied;
          the quoted history below a reply is folded into an expander.
        -->
        <DataTemplate x:Key="MessageTemplate">
            <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock Text="{Binding From}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Recipients}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,1,0,0" />
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource InkBrush}" Padding="0" Margin="0,8,0,0" FontSize="14" />
                    <Expander Header="Show quoted text" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12.5">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Quoted}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <TextBox Text="{Binding Quoted, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource MutedBrush}" Padding="0" Margin="0,4,0,0" FontSize="13" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
          The header's weight and color are set on the header's border, not on the TabItem: the tab's
          content inherits the TabItem's font, which made every message in the reader bold and grey.
        -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Underline" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="14,6,14,8" Margin="0,0,4,0"
                                TextElement.FontWeight="Bold" TextElement.FontSize="14" TextElement.Foreground="{StaticResource MutedBrush}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Underline" Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
