<Window x:Class="DailyDocket.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DailyDocket.App.ViewModels"
        Title="Set up DailyDocket" Icon="pack://application:,,,/DailyDocket;component/Assets/app.ico"
        Width="760" Height="620" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Set up DailyDocket" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="DailyDocket needs Claude Code, Git, a GitHub sign-in and your data repository on each computer. Each button does one step; sign-ins open your browser. The Gmail, Google Calendar and Slack connectors themselves are set up once, on claude.ai." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Done" IsDefault="True" Click="OnDone" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanClose}" />
            <Button DockPanel.Dock="Right" Content="Stop waiting" Command="{Binding StopWaitingCommand}" Margin="0,0,8,0"
                    ToolTip="Stop waiting for the sign-in in the browser"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Checking what is installed and signed in. This takes a few seconds." Style="{StaticResource Muted}" Margin="0,10"
                           Visibility="{Binding Checked, Converter={x:Static vm:Converters.FalseToVisible}}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="28" FontSize="16" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="o" />
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Unsure}" Value="True">
                                                        <Setter Property="Text" Value="?" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                        <Setter Property="Text" Value="&#x2713;" />
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="{Binding AlternateLabel}" CommandParameter="{Binding}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.AlternateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding HasAlternate, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding FixLabel}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Whose docket: the private repository holding the to-dos, Handled marks and docket.yaml. -->
                <Border Padding="28,14,0,12" Visibility="{Binding Checked, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Which data repository" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="To keep your own docket, make a private repository on GitHub (an empty one is fine) and enter it here as owner/name or its address. A copy of the current one on this computer is moved aside, not deleted." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Change" Command="{Binding ChangeRepositoryCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding RepositoryText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4,3"
                                     AutomationProperties.Name="Data repository" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
