<UserControl x:Class="DailyDocket.App.Views.ComposeBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A recipient: the address and a remove button. -->
        <DataTemplate x:Key="Recipient">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,1,4,1" Margin="0,0,5,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Foreground="{StaticResource AccentBrush}" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Content="&#x2715;" FontSize="10" Padding="4,0" Margin="4,0,0,0" BorderThickness="0" Background="Transparent" ToolTip="Remove"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource Tool}" Focusable="True" ToolTip="Close (the draft is kept)" Command="{Binding CloseCommand}" Margin="0" />
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Recipients, email only. -->
            <StackPanel Visibility="{Binding IsEmail, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="To" Style="{StaticResource Muted}" Width="28" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding To}" ItemTemplate="{StaticResource Recipient}" Tag="{Binding RemoveToCommand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBox Text="{Binding NewTo, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Margin="0,0,0,4" ToolTip="Type an address and press Enter">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddToCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </WrapPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="Cc" Style="{StaticResource Muted}" Width="28" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Cc}" ItemTemplate="{StaticResource Recipient}" Tag="{Binding RemoveCcCommand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBox Text="{Binding NewCc, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Margin="0,0,0,4" ToolTip="Type an address and press Enter">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCcCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>

            <!-- Formatting: WPF's own editing commands, aimed at the editor. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource Tool}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bold (Ctrl+B)">
                    <TextBlock Text="B" FontWeight="Bold" />
                </Button>
                <Button Style="{StaticResource Tool}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Italic (Ctrl+I)">
                    <TextBlock Text="I" FontStyle="Italic" />
                </Button>
                <Button Style="{StaticResource Tool}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Underline (Ctrl+U)"
                        Visibility="{Binding IsEmail, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="U" TextDecorations="Underline" />
                </Button>
                <Button Style="{StaticResource Tool}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" Content="&#x2022; List" ToolTip="Bulleted list" />
                <Button Style="{StaticResource Tool}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" Content="1. List" ToolTip="Numbered list" />
                <Button Style="{StaticResource Tool}" Content="Link" ToolTip="Make the selected text a link" Click="OnLink" />
            </StackPanel>

            <!-- Draft with Claude: fills the box for Mike to edit; it never sends. -->
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Draft with Claude" Command="{Binding DraftWithClaudeCommand}" Margin="6,0,0,0"
                        ToolTip="Claude drafts a reply from this conversation; you edit it and decide whether to send" />
                <TextBlock DockPanel.Dock="Left" Text="Say" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Guidance, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional: what the reply should say, e.g. yes, but next week">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding DraftWithClaudeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <RichTextBox x:Name="Editor" MinHeight="140" MaxHeight="420" VerticalScrollBarVisibility="Auto" AcceptsTab="False" SpellCheck.IsEnabled="True"
                         BorderBrush="{StaticResource LineBrush}" Padding="4" FontSize="14" TextChanged="OnTextChanged" />

            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Send" Click="OnSend" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Save to Gmail drafts" Click="OnSaveToGmail" Margin="6,0,0,0"
                        Visibility="{Binding IsEmail, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Put this reply in your Gmail drafts to finish elsewhere; nothing is sent" />
                <Button DockPanel.Dock="Right" Content="Discard" Command="{Binding DiscardCommand}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
