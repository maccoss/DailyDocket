<UserControl x:Class="DailyDocket.App.Views.TodoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DailyDocket.App.ViewModels"
             xmlns:views="clr-namespace:DailyDocket.App.Views">
    <UserControl.Resources>
        <!-- A tag chip: the artifact's colors; pressing one filters the list by it. -->
        <DataTemplate x:Key="TagChip" DataType="{x:Type vm:TagView}">
            <Button Command="{Binding DataContext.FilterByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}"
                    Background="{Binding Background}" Foreground="{Binding Foreground}" BorderThickness="0" Padding="9,1" Margin="0,0,5,4" FontSize="11.5"
                    ToolTip="Show only this tag">
                <TextBlock Text="{Binding Label}" />
            </Button>
        </DataTemplate>

        <Style x:Key="SmallLink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TodoTemplate" DataType="{x:Type vm:TodoView}">
            <Border Margin="0,0,0,6" Padding="10,9" CornerRadius="8" BorderThickness="3,1,1,1">
                <Border.InputBindings>
                    <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Late}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CritBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="&#x25B2;" Style="{StaticResource SmallLink}" Margin="0" FontSize="9" ToolTip="Move up (Alt+Up)"
                                Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Content="&#x25BC;" Style="{StaticResource SmallLink}" Margin="0,2,0,0" FontSize="9" ToolTip="Move down (Alt+Down)"
                                Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Done, Mode=OneWay}" Margin="0,2,8,0" VerticalAlignment="Top" ToolTip="Done"
                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />

                    <!-- Reading. -->
                    <StackPanel Grid.Column="2" Visibility="{Binding IsEditing, Converter={x:Static vm:Converters.FalseToVisible}}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- Web addresses in the notes (a Gmail link back to the email) are links. -->
                        <TextBlock views:LinkedText.Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap">
                            <TextBlock.Visibility>
                                <Binding Path="Notes" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <WrapPanel Margin="0,4,0,0">
                            <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Late}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource CritSoftBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource CritBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DueText}" Value="no date">
                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DueText}" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            </Border>
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420">
                                <TextBlock.Visibility>
                                    <Binding Path="Source" Converter="{x:Static vm:Converters.NonEmptyToVisibility}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Button Content="edit" Style="{StaticResource SmallLink}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Content="remove" Style="{StaticResource SmallLink}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Editing. -->
                    <StackPanel Grid.Column="2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Margin="0,6,0,0" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Tags" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma separated" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Due" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding EditDue}" Width="140" />
                            <Button DockPanel.Dock="Right" Content="Save" Margin="6,0,0,0"
                                    Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="Cancel" Foreground="{StaticResource MutedBrush}"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Add a task. Enter in the title adds it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Task" Style="{StaticResource Muted}" Width="52" VerticalAlignment="Center" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Details" Style="{StaticResource Muted}" Width="52" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Tags" Style="{StaticResource Muted}" Width="52" VerticalAlignment="Center" />
                    <TextBox DockPanel.Dock="Left" Text="{Binding NewTags, UpdateSourceTrigger=PropertyChanged}" Width="260" ToolTip="Comma separated" />
                    <TextBlock DockPanel.Dock="Left" Text="Due" Style="{StaticResource Muted}" Margin="16,0,6,0" VerticalAlignment="Center" />
                    <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding NewDue}" Width="140" />
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="OpenList" ItemsSource="{Binding Open}" ItemTemplate="{StaticResource TodoTemplate}" Focusable="False" AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnPressTask" PreviewMouseMove="OnDragTask" DragOver="OnDragOverTask" Drop="OnDropTask" />
                <TextBlock Text="DONE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,14,0,7"
                           Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TodoTemplate}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
