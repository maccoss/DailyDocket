<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 for now; it becomes net10.0-windows (with UseWPF) once the WPF shell exists, so the
      shell's service container can be built in a test, as in LabOps.
      xunit v3 test projects are executables.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DailyDocket.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests are short and not cancelled individually; passing the test token everywhere adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" Exclude="Fixtures\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DailyDocket.Core\DailyDocket.Core.csproj" />
    <ProjectReference Include="..\DailyDocket.Hook\DailyDocket.Hook.csproj" />
    <ProjectReference Include="..\DailyDocket.Data\DailyDocket.Data.csproj" />
  </ItemGroup>

</Project>
